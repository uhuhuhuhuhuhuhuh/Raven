{
  "name": "raven-webui",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e playwright.config.ts vite.config.ts",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "5.7.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.65.0",
    "vite": "7.1.1",
    "vitest": "3.2.4"
  }
}
